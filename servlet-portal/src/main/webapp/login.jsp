<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Portal Login</title><link rel="stylesheet" href="style.css"></head><body><main class="login card"><p class="eyebrow">COLLEGE PORTAL</p><h1>Sign in</h1><p>Use your configured demo account to view student profiles.</p><% if(request.getAttribute("error")!=null){ %><p class="error"><%= request.getAttribute("error") %></p><% } %><form method="post" action="login"><label>Username<input name="username" required autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button>Login</button></form></main></body></html>
