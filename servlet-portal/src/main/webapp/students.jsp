<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %>
<%! String esc(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");} %>
<% if(session.getAttribute("username")==null){response.sendRedirect("login");return;} List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students"); %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Profiles</title><link rel="stylesheet" href="style.css"></head><body><header><div><p class="eyebrow">ADMIN PORTAL</p><h1>Student profiles</h1></div><a href="logout">Logout</a></header><main><% if(students==null||students.isEmpty()){ %><section class="card">No students found. Add records through the PHP admin application.</section><% }else{ %><div class="grid"><% for(Map<String,Object> s:students){ %><article class="card"><h2><%=esc(s.get("name"))%></h2><p><b>Roll:</b> <%=esc(s.get("roll"))%></p><p><b>Email:</b> <%=esc(s.get("email"))%></p><p><b>Course:</b> <%=esc(s.get("course"))%></p><% if(s.get("fileId")!=null){ %><p><a href="file?id=<%=s.get("fileId")%>">Open <%=esc(s.get("fileName"))%></a></p><% }else{ %><p>No uploaded file for this row.</p><% } %></article><% } %></div><% } %></main></body></html>
